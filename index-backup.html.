<style>
:root{
 --bg:#090611;--panel:rgba(25,16,42,.94);
 --purple:#a855f7;--pink:#ec4899;--cyan:#67e8f9;
 --text:#f7f0ff;--muted:#a99bbd;
}
*{box-sizing:border-box}
body{
 margin:0;min-height:100vh;color:var(--text);
 background:radial-gradient(ellipse at 50% 15%,#321452 0%,transparent 40%),
 radial-gradient(ellipse at 10% 90%,#171044 0%,transparent 45%),var(--bg);
 font-family:Arial,sans-serif;overflow-x:hidden
}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
.app{position:relative;z-index:1;max-width:1150px;min-height:100vh;margin:auto;padding:20px;display:flex;flex-direction:column}
header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 0 18px;border-bottom:1px solid #c084fc22}
.brand{display:flex;align-items:center;gap:11px}
.brand-icon{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;font-size:22px;background:linear-gradient(135deg,#a855f7,#ec4899);box-shadow:0 0 25px #a855f755}
.brand h1{font-size:19px;margin:0;letter-spacing:1px}
.brand small{display:block;color:var(--muted);font-size:10px;letter-spacing:2px;margin-top:4px}
.header-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.icon-btn,.office-open{border:1px solid #a855f755;border-radius:13px;color:white;background:#ffffff08;padding:11px}
.office-open{background:linear-gradient(135deg,#9333ea,#6b21a8);font-size:12px;font-weight:bold}
main{flex:1;display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center;padding:25px 0}
.left{display:flex;flex-direction:column;align-items:center;justify-content:center}
.orb-area{width:100%;min-height:340px;display:grid;place-items:center;position:relative}
.orb{width:205px;height:205px;position:relative;border-radius:50%;background:radial-gradient(circle at 32% 28%,#fff 0%,#e9baff 4%,#bd73ff 13%,#8529d5 35%,#42106f 65%,#170625 100%);box-shadow:0 0 20px #c084fc,0 0 55px #a855f799,0 0 110px #9333ea66,inset -15px -18px 35px #090313;animation:float 4s ease-in-out infinite}
.orb:before{content:"";position:absolute;inset:-16px;border-radius:50%;border:1px solid #c084fc88;animation:rotate 12s linear infinite}
.orb:after{content:"";position:absolute;inset:-32px;border-radius:50%;border:1px dashed #67e8f955;animation:rotate 20s linear infinite reverse}
.orb-core{position:absolute;inset:22%;border-radius:50%;background:radial-gradient(circle,#fff,#f0abfc 10%,#c084fc 35%,#7e22ce 75%,transparent);filter:blur(3px);animation:core 3s infinite}
.orb-ring{position:absolute;width:270px;height:90px;border:2px solid #c084fc77;border-radius:50%;transform:rotate(-20deg);animation:ring 5s infinite}
.orb-ring.second{width:290px;height:110px;transform:rotate(55deg);border-color:#67e8f955}
@keyframes float{50%{transform:translateY(-12px)}}
@keyframes rotate{to{transform:rotate(360deg)}}
@keyframes core{50%{transform:scale(1.12);opacity:1}}
@keyframes ring{50%{opacity:1;scale:1.08}}
.orb.speaking{filter:brightness(1.4);animation:float 4s infinite,voicePulse .22s infinite alternate}
.orb.listening{filter:hue-rotate(35deg) brightness(1.2)}
.orb.thinking{filter:hue-rotate(65deg) brightness(1.4)}
@keyframes voicePulse{to{scale:1.075}}
.orb-status{margin-top:28px;text-align:center}
.orb-status strong{display:block;font-size:20px;letter-spacing:2px}
.orb-status span{color:var(--muted);font-size:12px;display:block;margin-top:8px}
.quick-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:9px;margin-top:18px}
.quick-actions button,.tool-btn{color:#e9d5ff;background:#ffffff08;border:1px solid #a855f744;border-radius:12px;padding:10px 13px;font-size:12px}
.chat-panel{height:590px;max-height:75vh;display:flex;flex-direction:column;border:1px solid #a855f733;background:var(--panel);border-radius:22px;overflow:hidden}
.chat-top{padding:17px;border-bottom:1px solid #a855f722;display:flex;justify-content:space-between}
.messages{flex:1;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:14px}
.message{max-width:88%;padding:12px 14px;border-radius:16px;line-height:1.5;font-size:14px;white-space:pre-wrap;overflow-wrap:anywhere}
.message.katia{align-self:flex-start;background:#51217a99;border:1px solid #c084fc33}
.message.user{align-self:flex-end;background:linear-gradient(135deg,#8b35c9,#6324a1)}
.sender{display:block;color:#e9baff;font-size:10px;margin-bottom:5px}
.composer{padding:13px;border-top:1px solid #a855f722;display:flex;gap:8px}
.composer input{flex:1;min-width:0;color:white;background:#ffffff0b;border:1px solid #a855f744;border-radius:14px;padding:14px}
.send-btn,.mic-btn{border:0;width:44px;height:44px;border-radius:14px;color:white;background:linear-gradient(135deg,#a855f7,#7e22ce)}
footer{text-align:center;color:#766784;font-size:10px;padding:12px}
.overlay,.office-overlay{display:none;position:fixed;inset:0;z-index:30;background:#080510f5;overflow-y:auto;padding:12px}
.overlay.open,.office-overlay.open{display:block}
.drawer,.office-wrap{max-width:850px;margin:12px auto;background:#130c20;border:1px solid #a855f755;border-radius:20px;padding:20px}
.drawer{max-width:390px}
.drawer textarea,.drawer input,.drawer select,.office-field input,.office-field textarea,.office-field select{
 width:100%;padding:12px;margin:7px 0;border-radius:12px;border:1px solid #a855f744;background:#ffffff0b;color:white
}
.drawer button.action,.office-primary{width:100%;padding:13px;border:0;border-radius:12px;color:white;background:linear-gradient(135deg,#9333ea,#6b21a8);margin-top:8px}
.office-head{display:flex;justify-content:space-between;align-items:center;gap:10px;border-bottom:1px solid #a855f733;padding-bottom:15px}
.office-head h2{margin:0;font-size:21px}
.office-head p,.small-note{color:var(--muted);font-size:12px;line-height:1.5}
.office-close{background:#ffffff0b;color:white;border:1px solid #a855f755;border-radius:10px;padding:10px}
.office-intro,.document-panel{padding:16px;border:1px solid #a855f733;border-radius:15px;background:#a855f70d;margin:17px 0}
.office-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.office-field{margin:10px 0}
.office-field label{display:block;color:#d8b4fe;font-size:12px;margin-bottom:6px}
.office-field textarea{min-height:100px}
.office-primary{font-weight:bold;padding:15px}
.office-status{font-size:12px;color:#c4b5fd;min-height:22px;margin-top:12px;white-space:pre-wrap}
.office-modules{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:20px}
.office-module{border:1px solid #a855f733;border-radius:13px;padding:13px;background:#ffffff06;text-align:center}
.office-module strong{display:block;font-size:13px;margin-bottom:5px}
.office-module small{font-size:10px;color:var(--muted)}
.file-label{display:block;padding:20px;border:2px dashed #a855f766;border-radius:15px;text-align:center;color:#e9d5ff;cursor:pointer;background:#a855f70b}
.file-label input{display:none}
.document-actions{display:flex;gap:8px;flex-wrap:wrap}
.document-actions button{flex:1;min-width:120px}
#documentPrompt{min-height:100px}
#documentPreview{white-space:pre-wrap;max-height:300px;overflow:auto;background:#080510;padding:12px;border-radius:12px;font-size:12px;color:#d8c5e8}
@media(max-width:760px){
 .app{padding:14px}
 main{grid-template-columns:1fr;gap:10px;padding:12px 0}
 .orb-area{min-height:260px}.orb{width:155px;height:155px}
 .orb-ring{width:215px;height:70px}.orb-ring.second{width:235px;height:85px}
 .chat-panel{height:480px;max-height:58vh}
 .office-grid{grid-template-columns:1fr}
 .office-modules{grid-template-columns:1fr 1fr}
 .office-wrap{padding:14px}
}
</style>
</head>
