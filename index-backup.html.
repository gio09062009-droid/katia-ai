      <script>
/* ==========================================
   KATIA AI - CONFIGURACIÓN PRINCIPAL
========================================== */

const KATIA_API = "https://katia-braine.gio09062009.workers.dev/";

const STORAGE = {
 history: "katia_history_4",
 memories: "katia_memories_4",
 diary: "katia_diary_4",
 likes: "katia_likes_4",
 username: "katia_user_name_4",
 apiKey: "katia_gemini_key_4",
 provider: "katia_provider_4"
};

let historial = cargar(STORAGE.history, []);
let memorias = cargar(STORAGE.memories, []);
let diario = cargar(STORAGE.diary, []);
let gustos = cargar(STORAGE.likes, []);
let ultimoMensaje = "";
let reconociendo = false;
let reconocimiento = null;
let typingElement = null;

/* ==========================================
   ALMACENAMIENTO
========================================== */

function cargar(key, fallback) {
 try {
  const data = localStorage.getItem(key);
  return data ? JSON.parse(data) : fallback;
 } catch (error) {
  return fallback;
 }
}

function guardar(key, value) {
 try {
  localStorage.setItem(key, JSON.stringify(value));
 } catch (error) {
  console.warn("No se pudo guardar:", key, error);
 }
}

function guardarTodo() {
 guardar(STORAGE.history, historial);
 guardar(STORAGE.memories, memorias);
 guardar(STORAGE.diary, diario);
 guardar(STORAGE.likes, gustos);
}

function nombreUsuario() {
 return localStorage.getItem(STORAGE.username) || "";
}

/* ==========================================
   ESTADO DE LA ESFERA
========================================== */

function estadoOrb(estado, texto) {
 const orb = document.getElementById("orb");
 const status = document.getElementById("statusText");

 if (!orb || !status) return;

 orb.classList.remove("speaking", "listening", "thinking");

 if (estado) orb.classList.add(estado);
 status.textContent = texto || "🟢 En línea";
}

/* ==========================================
   MENSAJES
========================================== */

function escaparHTML(texto) {
 return String(texto).replace(/[&<>"']/g, function(c) {
  return {
   "&": "&amp;",
   "<": "&lt;",
   ">": "&gt;",
   '"': "&quot;",
   "'": "&#039;"
  }[c];
 });
}

function agregarMensaje(tipo, texto, guardarEnHistorial = true) {
 const messages = document.getElementById("messages");
 if (!messages) return;

 const div = document.createElement("div");
 div.className = "message " + tipo;

 const sender = document.createElement("span");
 sender.className = "sender";
 sender.textContent = tipo === "user" ? "VOS" : "KATIA 💜";

 const content = document.createElement("div");
 content.textContent = texto;

 div.appendChild(sender);
 div.appendChild(content);
 messages.appendChild(div);

 messages.scrollTop = messages.scrollHeight;

 if (guardarEnHistorial) {
  historial.push({
   role: tipo === "user" ? "user" : "assistant",
   content: texto,
   time: new Date().toISOString()
  });

  if (historial.length > 80) {
   historial = historial.slice(-80);
  }

  guardar(STORAGE.history, historial);
 }

 if (tipo === "katia") {
  ultimoMensaje = texto;
 }

 return div;
}

function restaurarHistorial() {
 const messages = document.getElementById("messages");
 if (!messages) return;

 messages.innerHTML = "";

 if (!historial.length) {
  agregarMensaje(
   "katia",
   "¡Holaaa! 💜 Soy Katia. ¿Qué hacemos hoy?",
   false
  );
  return;
 }

 historial.slice(-50).forEach(item => {
  agregarMensaje(
   item.role === "user" ? "user" : "katia",
   item.content,
   false
  );
 });
}

function mostrarTyping() {
 quitarTyping();

 const messages = document.getElementById("messages");
 typingElement = document.createElement("div");
 typingElement.className = "message katia";
 typingElement.textContent = "Katia está pensando... ✨";

 messages.appendChild(typingElement);
 messages.scrollTop = messages.scrollHeight;
}

function quitarTyping() {
 if (typingElement) {
  typingElement.remove();
  typingElement = null;
 }
}

/* ==========================================
   CONTEXTO DE KATIA
========================================== */

function construirMensajesIA() {
 const usuario = nombreUsuario();

 let contexto = `
Sos Katia AI, una asistente virtual inteligente.
Respondé en español natural, con personalidad amable,
alegre, clara y cercana.

Podés ayudar con:
- Explicaciones y aprendizaje.
- Escritura y corrección.
- Organización de ideas.
- Programación.
- Análisis de documentos.
- Creación de documentos.
- Conversaciones generales.

Tu nombre es Katia.
${usuario ? "El nombre del usuario es " + usuario + "." : ""}

MEMORIA DEL USUARIO:
${memorias.slice(-15).join("\n") || "Todavía no hay recuerdos guardados."}

GUSTOS:
${gustos.slice(-15).join("\n") || "Todavía no hay gustos guardados."}

DIARIO:
${diario.slice(-10).join("\n") || "Todavía no hay entradas."}

No inventes datos que no conozcas.
Si no sabés algo, explicalo con honestidad.
`;

 const recent = historial.slice(-20).map(item => ({
  role: item.role,
  content: item.content
 }));

 return [
  { role: "system", content: contexto },
  ...recent
 ];
}

/* ==========================================
   CONEXIÓN CON EL WORKER
========================================== */

async function responderConIA() {
 const messages = construirMensajesIA();

 const response = await fetch(KATIA_API, {
  method: "POST",
  headers: {
   "Content-Type": "application/json"
  },
  body: JSON.stringify({
   messages: messages
  })
 });

 if (!response.ok) {
  throw new Error("El servidor respondió con error: " + response.status);
 }

 const data = await response.json();

 if (typeof data.reply === "string") {
  return data.reply;
 }

 if (typeof data.response === "string") {
  return data.response;
 }

 if (typeof data.message === "string") {
  return data.message;
 }

 throw new Error("El servidor no devolvió una respuesta reconocible.");
}

/* ==========================================
   CONVERSACIÓN PRINCIPAL
========================================== */

async function enviarMensaje() {
 const input = document.getElementById("userInput");
 const texto = input.value.trim();

 if (!texto) return;

 input.value = "";

 agregarMensaje("user", texto);
 mostrarTyping();

 estadoOrb("thinking", "🧠 Katia está pensando...");

 try {
  const respuesta = await responderConIA();

  quitarTyping();

  agregarMensaje("katia", respuesta);
  estadoOrb("", "🟢 En línea · Lista para hablar");

 } catch (error) {
  quitarTyping();

  agregarMensaje(
   "katia",
   "Tuve un problema al conectarme con mi cerebro. 💜\n\n" +
   "Revisá tu conexión a internet o el Worker e intentá nuevamente.\n\n" +
   "Detalle: " + error.message
  );

  estadoOrb("", "⚠️ Problema de conexión");
  console.error(error);
 }
}

document.getElementById("userInput").addEventListener("keydown", event => {
 if (event.key === "Enter") enviarMensaje();
});

/* ==========================================
   SALUDO Y CHAT
========================================== */

function saludar() {
 document.getElementById("userInput").value =
  "Hola Katia, ¿cómo estás hoy?";
 enviarMensaje();
}

function limpiarChat() {
 if (!confirm("¿Querés borrar el historial de conversación?")) return;

 historial = [];
 guardar(STORAGE.history, historial);
 restaurarHistorial();
 ultimoMensaje = "";
}

/* ==========================================
   MEMORIA
========================================== */

function abrirMemoria() {
 const panel = document.getElementById("panelContent");

 panel.innerHTML = `
  <p>🧠 Recuerdos guardados de Katia.</p>
  <textarea id="memoryInput" placeholder="Escribí algo que Katia debería recordar..."></textarea>
  <button class="action" onclick="guardarMemoria()">Guardar recuerdo</button>
  <div id="memoryList"></div>
 `;

 mostrarMemorias();
}

function guardarMemoria() {
 const input = document.getElementById("memoryInput");
 const texto = input.value.trim();

 if (!texto) return;

 memorias.push(texto);
 guardar(STORAGE.memories, memorias);

 input.value = "";
 mostrarMemorias();
}

function mostrarMemorias() {
 const list = document.getElementById("memoryList");
 if (!list) return;

 list.innerHTML = "<h3>Recuerdos</h3>";

 memorias.forEach((item, index) => {
