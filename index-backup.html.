/* ==========================================
   CREAR ARCHIVO WORD
========================================== */

async function generarWord(texto, nombre) {
    if (!window.docx) {
        throw new Error("La biblioteca Word no está disponible.");
    }

    const { Document, Packer, Paragraph, TextRun, HeadingLevel } = window.docx;

    const parrafos = texto.split(/\r?\n/).map(linea => {
        const contenido = linea.trim();

        if (/^#{1,2}\s/.test(contenido)) {
            return new Paragraph({
                text: contenido.replace(/^#{1,2}\s/, ""),
                heading: HeadingLevel.HEADING_1
            });
        }

        return new Paragraph({
            children: [
                new TextRun({
                    text: contenido
                })
            ]
        });
    });

    const documento = new Document({
        sections: [{
            children: parrafos
        }]
    });

    const blob = await Packer.toBlob(documento);

    descargarBlob(blob, nombre + ".docx");
}

/* ==========================================
   CREAR ARCHIVO EXCEL
========================================== */

function generarExcel(texto, nombre) {
    if (!window.XLSX) {
        throw new Error("La biblioteca Excel no está disponible.");
    }

    const filas = texto.split(/\r?\n/).map(linea =>
        linea.split(/\t|;/).map(celda => celda.trim())
    ).filter(fila => fila.some(celda => celda));

    const hoja = XLSX.utils.aoa_to_sheet(filas);

    const libro = XLSX.utils.book_new();

    XLSX.utils.book_append_sheet(
        libro,
        hoja,
        "Datos"
    );

    XLSX.writeFile(libro, nombre + ".xlsx");
}

/* ==========================================
   CREAR POWERPOINT
========================================== */

async function generarPowerPoint(texto, nombre) {
    if (typeof pptxgen === "undefined") {
        throw new Error("La biblioteca PowerPoint no está disponible.");
    }

    const presentacion = new pptxgen();

    presentacion.layout = "LAYOUT_WIDE";
    presentacion.author = "Katia AI";
    presentacion.subject = "Presentación creada con Katia AI";
    presentacion.title = nombre;

    presentacion.theme = {
        headFontFace: "Aptos Display",
        bodyFontFace: "Aptos"
    };

    let secciones = texto
        .split(/\n(?=#{1,2}\s)|\n(?=DIAPOSITIVA\s+\d+)/i)
        .map(item => item.trim())
        .filter(Boolean);

    if (secciones.length < 2) {
        const lineas = texto.split(/\r?\n/).filter(Boolean);
        secciones = [];

        for (let i = 0; i < lineas.length; i += 5) {
            secciones.push(lineas.slice(i, i + 5).join("\n"));
        }
    }

    secciones.forEach((seccion, index) => {
        const lineas = seccion.split(/\r?\n/).filter(Boolean);

        const titulo = lineas[0]
            .replace(/^#{1,2}\s/, "")
            .replace(/^DIAPOSITIVA\s+\d+/i, "Diapositiva " + (index + 1));

        const cuerpo = lineas.slice(1).join("\n") || seccion;

        const slide = presentacion.addSlide();

        slide.background = {
            color: "100B1D"
        };

        slide.addText(titulo || "Katia AI", {
            x: 0.6,
            y: 0.45,
            w: 12,
            h: 0.8,
            fontFace: "Aptos Display",
            fontSize: 27,
            bold: true,
            color: "D8B4FE",
            margin: 0.05,
            breakLine: false
        });

        slide.addShape(presentacion.ShapeType.line, {
            x: 0.6,
            y: 1.35,
            w: 11.8,
            h: 0,
            line: {
                color: "A855F7",
                width: 2
            }
        });

        slide.addText(cuerpo, {
            x: 0.8,
            y: 1.7,
            w: 11.5,
            h: 5.1,
            fontFace: "Aptos",
            fontSize: 19,
            color: "F7F0FF",
            valign: "top",
            breakLine: false,
            margin: 0.1,
            fit: "shrink"
        });

        slide.addText(
            "KATIA AI  •  " + (index + 1),
            {
                x: 10.8,
                y: 7.05,
                w: 1.8,
                h: 0.2,
                fontSize: 9,
                color: "A99BBD",
                align: "right"
            }
        );
    });

    await presentacion.writeFile({
        fileName: nombre + ".pptx"
    });
}

/* ==========================================
   CREAR PDF
========================================== */

function generarPDF(texto, nombre) {
    if (!window.jspdf || !window.jspdf.jsPDF) {
        throw new Error("La biblioteca PDF no está disponible.");
    }

    const { jsPDF } = window.jspdf;

    const pdf = new jsPDF({
        orientation: "portrait",
        unit: "mm",
        format: "a4"
    });

    const margen = 18;
    const ancho = 174;
    const altoPagina = 280;

    let y = 20;

    pdf.setFont("helvetica", "normal");
    pdf.setFontSize(11);

    const lineas = pdf.splitTextToSize(texto, ancho);

    lineas.forEach(linea => {
        if (y > altoPagina) {
            pdf.addPage();
            y = 20;
        }

        pdf.text(linea, margen, y);
        y += 6;
    });

    pdf.save(nombre + ".pdf");
}

