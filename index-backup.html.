========================================== */

async function leerWord(archivo) {
    if (!window.mammoth) {
        throw new Error("La biblioteca Word no está disponible.");
    }

    const buffer = await archivo.arrayBuffer();

    const resultado = await mammoth.extractRawText({
        arrayBuffer: buffer
    });

    textoDocumento = resultado.value;
}

/* ==========================================
   LECTOR EXCEL
========================================== */

async function leerExcel(archivo) {
    if (!window.XLSX) {
        throw new Error("La biblioteca Excel no está disponible.");
    }

    const buffer = await archivo.arrayBuffer();

    const libro = XLSX.read(buffer, {
        type: "array"
    });

    let contenido = "";

    libro.SheetNames.forEach(nombre => {
        const hoja = libro.Sheets[nombre];

        contenido += "\n\nHOJA: " + nombre + "\n";

        contenido += XLSX.utils.sheet_to_csv(hoja);
    });

    textoDocumento = contenido;
}

/* ==========================================
   LECTOR POWERPOINT
========================================== */

async function leerPowerPoint(archivo) {
    if (!window.JSZip) {
        throw new Error("La biblioteca PowerPoint no está disponible.");
    }

    const zip = await JSZip.loadAsync(archivo);

    const diapositivas = Object.keys(zip.files)
        .filter(nombre => /^ppt\/slides\/slide\d+\.xml$/.test(nombre))
        .sort((a, b) => {
            const numeroA = Number(a.match(/slide(\d+)/)[1]);
            const numeroB = Number(b.match(/slide(\d+)/)[1]);

            return numeroA - numeroB;
        });

    let contenido = "";

    for (let i = 0; i < diapositivas.length; i++) {
        const xml = await zip.file(diapositivas[i]).async("string");

        const documento = new DOMParser().parseFromString(
            xml,
            "application/xml"
        );

        const textos = Array.from(
            documento.getElementsByTagName("a:t")
        ).map(nodo => nodo.textContent);

        contenido += "\n\nDIAPOSITIVA " + (i + 1) + "\n";
        contenido += textos.join(" ");
    }

    textoDocumento = contenido;
}

/* ==========================================
   LECTOR PDF
========================================== */

async function leerPDF(archivo) {
    if (!window.pdfjsLib) {
        throw new Error("La biblioteca PDF no está disponible.");
    }

    const buffer = await archivo.arrayBuffer();

    const pdf = await pdfjsLib.getDocument({
        data: new Uint8Array(buffer)
    }).promise;

    let contenido = "";

    for (let pagina = 1; pagina <= pdf.numPages; pagina++) {
        const paginaPDF = await pdf.getPage(pagina);

        const contenidoPagina = await paginaPDF.getTextContent();

        const texto = contenidoPagina.items
            .map(item => item.str)
            .join(" ");

        contenido += "\n\nPÁGINA " + pagina + "\n";
        contenido += texto;
    }

    textoDocumento = contenido;
}

