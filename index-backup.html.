async function crearArchivo(tipo, texto, nombre) {
    nombre = nombreSeguro(nombre);

    if (!texto || !texto.trim()) {
        throw new Error("No hay contenido para crear el archivo.");
    }

    if (tipo === "docx") {
        await generarWord(texto, nombre);

    } else if (tipo === "xlsx") {
        generarExcel(texto, nombre);

    } else if (tipo === "pptx") {
        await generarPowerPoint(texto, nombre);

    } else if (tipo === "pdf") {
        generarPDF(texto, nombre);

    } else {
        throw new Error("Formato de archivo desconocido.");
    }
}

