    } catch (error) {
        console.error(error);
        alert("No se pudo crear el archivo: " + error.message);
    }
}

/* ==========================================
   CREAR DOCUMENTOS NUEVOS CON IA
========================================== */

async function crearDocumentoNuevo() {
    const tipo = document.getElementById("newFileType").value;

    const nombre =
        document.getElementById("newFileName").value.trim() ||
        "Documento_Katia";

    const instrucciones =
        document.getElementById("newFileContent").value.trim();

    if (!instrucciones) {
        alert("Describí qué archivo querés crear.");
        return;
    }

    const boton = document.querySelector(
        "#officeOverlay .office-intro .office-primary"
    );

    estadoOffice(
        "createStatus",
        "🧠 Katia está preparando el contenido..."
    );

    if (boton) boton.disabled = true;

    try {
        let formato = "";

        if (tipo === "xlsx") {
            formato =
                "Devolvé una tabla para Excel. Usá tabulaciones entre columnas y saltos de línea entre filas. No uses tablas Markdown.";
        } else if (tipo === "pptx") {
            formato =
                "Prepará una presentación PowerPoint. Separá cada diapositiva con un título que comience con ##. Usá texto breve y organizado.";
        } else {
            formato =
                "Prepará un documento completo, organizado, con títulos y párrafos claros.";
        }

        const respuesta = await fetch(KATIA_API, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                messages: [
                    {
                        role: "system",
                        content:
                            "Sos Katia AI, especialista en creación de archivos. " +
                            "Entregá contenido útil, completo y bien organizado. " +
                            "No agregues explicaciones sobre el proceso. " +
                            formato
                    },
                    {
                        role: "user",
                        content: instrucciones
                    }
                ]
            })
        });

        if (!respuesta.ok) {
            throw new Error("Error del servidor: " + respuesta.status);
        }

        const datos = await respuesta.json();

        const contenido =
            datos.reply ||
            datos.response ||
            datos.message;

        if (typeof contenido !== "string" || !contenido.trim()) {
            throw new Error("Katia no devolvió contenido.");
        }

        estadoOffice(
            "createStatus",
            "📦 Preparando el archivo " + tipo.toUpperCase() + "..."
        );

        await crearArchivo(tipo, contenido, nombre);

        estadoOffice(
            "createStatus",
            "✅ ¡Archivo creado! Revisá tus descargas."
        );

    } catch (error) {
        console.error(error);

        estadoOffice(
            "createStatus",
            "❌ No se pudo crear el archivo: " + error.message
        );

    } finally {
        if (boton) boton.disabled = false;
    }
}

