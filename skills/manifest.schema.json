{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://katia.ai/schemas/skill-manifest-1.0.schema.json",
  "title": "Katia Skill Manifest",
  "description": "Metadata contract for declarative Katia Skills. Packages are untrusted data and must never execute arbitrary code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "id",
    "name",
    "version",
    "description",
    "publisher",
    "capabilities",
    "permissions",
    "entrypoint"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        }
      }
    },
    "minimum_katia_version": {
      "type": "string",
      "maxLength": 32
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{2,32}$"
      },
      "uniqueItems": true,
      "maxItems": 12
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$"
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 20,
      "items": {
        "type": "string",
        "enum": [
          "network.read",
          "network.write",
          "files.read",
          "files.write",
          "documents.create",
          "documents.modify",
          "github.read",
          "github.write",
          "device.open_app",
          "messages.draft",
          "messages.send",
          "user.profile.read"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
          },
          "version": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "const": "declarative"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.).+\\.(json|md)$"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "license": {
      "type": "string",
      "maxLength": 64
    }
  }
}
